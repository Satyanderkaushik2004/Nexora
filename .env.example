# NEXORA AI Router -- example configuration.
# Copy this file to `.env` and fill in only the providers you want to use.
# `.env` is git-ignored. Never commit real keys.

# ---- Provider credentials (leave empty to disable a provider) ----
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

# ---- Models (optional; defaults shown) ----
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat
# PERPLEXITY_MODEL=sonar

# ---- Local provider (Ollama, no API key needed) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# OLLAMA_TIMEOUT=120

# ---- Server (optional; defaults shown) ----
# NEXORA_HOST=127.0.0.1
# NEXORA_PORT=5000
# Development only: enables Flask debug mode. Refused unless NEXORA_HOST is 127.0.0.1.
# NEXORA_DEBUG=false
# NEXORA_LOG_LEVEL=INFO

# ---- Limits (optional; defaults shown) ----
# NEXORA_REQUEST_TIMEOUT=60
# NEXORA_MAX_QUERY_CHARS=8000
# NEXORA_MAX_TITLE_INPUT_CHARS=2000

# ---- Alternate routing config file (optional) ----
# NEXORA_CONFIG=configs/config.json
